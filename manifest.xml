  <Var name="bmwCustomCarActive" type="number" expression="gt(#bmwRenderUseImage,0)*gt(len(@bmwRenderImage),0)" />
  <Var name="bmwCustomCarReady" type="number" expression="#bmwCustomCarActive*#bmwCustomCar.has_bitmap" />
  <Var name="bmwCarMaxW" type="number" expression="0.615*#view_width*max(60,min(150,#bmwRenderScale))/100" />
  <Var name="bmwCarMaxH" type="number" expression="0.340*#view_height*max(60,min(150,#bmwRenderScale))/100" />
  <Var name="bmwCarRatio" type="number" expression="max(1,#bmwCustomCar.bmp_width)/max(1,#bmwCustomCar.bmp_height)" />
  <Var name="bmwCarFitW" type="number" expression="min(#bmwCarMaxW,#bmwCarMaxH*#bmwCarRatio)" />
  <Var name="bmwCarFitH" type="number" expression="min(#bmwCarMaxH,#bmwCarMaxW/#bmwCarRatio)" />
