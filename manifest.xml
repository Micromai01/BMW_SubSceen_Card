  <Var name="bmwModelSize" type="number" expression="ifelse(isnull(#bmwModelSize),7,#bmwModelSize)" const="true" />
  <Var name="bmwCompatReady" type="number" expression="0" const="true" />
  <Var name="bmwCompatName" type="string" expression="''" const="true" />
  <Var name="bmwRenderName" type="string" expression="ifelse(#bmwCompatReady,@bmwCompatName,@bmwDisplayName)" />
  <Var name="bmwCompatModel" type="string" expression="''" const="true" />
  <Var name="bmwRenderModel" type="string" expression="ifelse(#bmwCompatReady,@bmwCompatModel,@bmwDisplayModel)" />
  <Var name="bmwCompatImage" type="string" expression="''" const="true" />
  <Var name="bmwRenderImage" type="string" expression="ifelse(#bmwCompatReady,@bmwCompatImage,@bmwCustomImage)" />
  <Var name="bmwCompatUseImage" type="number" expression="1" const="true" />
  <Var name="bmwRenderUseImage" type="number" expression="ifelse(#bmwCompatReady,#bmwCompatUseImage,#bmwUseCustomImage)" />
  <Var name="bmwCompatScale" type="number" expression="100" const="true" />
  <Var name="bmwRenderScale" type="number" expression="ifelse(#bmwCompatReady,#bmwCompatScale,#bmwCarScale)" />
  <Var name="bmwCompatOffsetX" type="number" expression="0" const="true" />
  <Var name="bmwRenderOffsetX" type="number" expression="ifelse(#bmwCompatReady,#bmwCompatOffsetX,#bmwCarOffsetX)" />
