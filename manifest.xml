  <Var name="bmwDisplayModel" type="string" expression="ifelse(isnull(@bmwDisplayModel),'eDrive35L',@bmwDisplayModel)" const="true" />
  <Var name="bmwCustomImage" type="string" expression="ifelse(isnull(@bmwCustomImage),'',@bmwCustomImage)" const="true" />
  <Var name="bmwUseCustomImage" type="number" expression="ifelse(isnull(#bmwUseCustomImage),1,#bmwUseCustomImage)" const="true" />
